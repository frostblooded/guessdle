{
  "name": "guessdle",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "vite build --minify false --sourcemap",
    "build:prod": "vite build",
    "watch": "npm run build -- --watch",
    "test:e2e": "npm run build && npm run typecheck && tsc -p tests/e2e && playwright test -c tests/e2e",
    "test": "npm run typecheck && tsc -p tsconfig.test.json && vitest run --project unit --project ui",
    "typecheck": "tsc && tsc -p tests/ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "dup": "jscpd src --min-lines 8 --min-tokens 80 --threshold 0 --reporters console",
    "check": "npm run lint && npm run format:check && npm run dup && npm test && npm run test:integration && npm run test:e2e",
    "test:integration": "tsc -p tsconfig.test.json && vitest run --project integration",
    "dev": "vite",
    "icons": "node scripts/build-icons.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "jscpd": "^5.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/courier-prime": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^2.3.1",
    "downshift": "^9.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "archiver-utils": {
      "glob": "^13.0.6"
    }
  }
}
