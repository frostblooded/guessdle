{
  "name": "guessdle",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build-prod.mjs",
    "watch": "npm run build -- --watch",
    "test:e2e": "npm run build && npm run typecheck && tsc -p tests/e2e && playwright test -c tests/e2e",
    "test": "npm run typecheck && tsc -p tsconfig.test.json && node --test \"tests/*.test.ts\"",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "dup": "jscpd src --min-lines 8 --min-tokens 80 --threshold 0 --reporters console",
    "check": "npm run lint && npm run format:check && npm run dup && npm test && npm run test:integration && npm run test:e2e",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=120000 \"tests/integration/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@tarekraafat/autocomplete.js": "^10.2.10",
    "express": "^5.3.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
