{
  "name": "petdle",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "esbuild script.ts --bundle --sourcemap --target=es2020 --loader:.svg=file --outdir=dist",
    "watch": "npm run build -- --watch",
    "test:e2e": "npm run build && npm run typecheck && tsc -p tests/e2e && playwright test -c tests/e2e",
    "test": "npm run typecheck && tsc -p tsconfig.test.json && node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/seedrandom": "^3.0.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@tarekraafat/autocomplete.js": "^10.2.10",
    "seedrandom": "^3.0.5"
  }
}
