# Copy to .env for `npm start` (docker compose -f deploy/compose.yaml up -d db)
DATABASE_URL=postgres://petdle:petdle@localhost:5432/petdle
SERVER_TIMEZONE=Europe/Sofia
# Google sign-in (optional locally); ADMIN_EMAILS is comma-separated
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
ADMIN_EMAILS=
# Backups volume with status.json (the API mounts it read-only); default /backups
BACKUP_DIR=
