# Copy to .env for `npm start` (docker compose up -d db)
DATABASE_URL=postgres://petdle:petdle@localhost:5432/petdle
SERVER_TIMEZONE=Europe/Sofia
# Email sign-in links; unset SMTP_HOST answers 503. `docker compose up -d mailpit` gives an inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_URL=http://localhost:8080
# Comma-separated; these emails become admins on sign-in
ADMIN_EMAILS=
# Backups volume with status.json (the API mounts it read-only); default /backups
BACKUP_DIR=
