{
  "permissions": {
    "allow": ["Bash(npx tsc)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/cloud-setup.mjs",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/caveman/caveman-activate.js",
            "timeout": 30,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/ponytail/ponytail-activate.js",
            "timeout": 30,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/prettier.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/kill-orphans.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/caveman/caveman-stats.js --record",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/caveman/caveman-activate.js --subagent",
            "timeout": 30,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/ponytail/ponytail-subagent.js",
            "timeout": 30,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/caveman/caveman-mode-tracker.js",
            "timeout": 30,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/ponytail/ponytail-mode-tracker.js",
            "timeout": 30,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
